# Freedom Blades portal — TEMPORARY test site. Authored 2026-08-23 by P3.5.
#
# Additive: it defines one new hostname and does not touch the existing
# freedom-blades or foundry blocks. Delete this file and its import line at
# go-live, together with the Cloudflare DNS record.

freedom-blades-test.rpgworld.org {
	# The Cloudflare Origin CA wildcard already on this host. Trusted by
	# Cloudflare and by nothing else, so the DNS record must stay proxied (F-10).
	tls /etc/ssl/rpgworld/cloudflare.pem /etc/ssl/rpgworld/cloudflare.key

	encode zstd gzip
	header -Server

	# HSTS (N-22). Operational contract §4.1 gives Caddy two jobs, TLS and HSTS,
	# and until 2026-08-27 this file implemented only the first. One year is the
	# contract's floor.
	#
	# **No `includeSubDomains`.** The decision stands; the reason recorded for it
	# on 2026-08-27 did not, and is corrected here rather than left to be
	# rediscovered. It said the directive was reserved "until the Operations
	# Owner confirms no sibling host under `rpgworld.org` would break, and the
	# Foundry hosts are siblings". **That is not what the directive does.**
	# `includeSubDomains` binds the host that sent the header *and names beneath
	# it* (RFC 6797 §6.1.2) — here, `*.freedom-blades-test.rpgworld.org` — so
	# `foundry1.rpgworld.org` and its two peers are **siblings, not subdomains,
	# and are unaffected either way**. The stated risk did not exist. It would
	# only reach the Foundry hosts if this header were served from the apex
	# `rpgworld.org`, and no block serves the apex.
	#
	# **Why it is still omitted, on a reason that holds:** no name exists beneath
	# this host, so the directive would buy nothing today while committing every
	# future name under it to HTTPS-only for a year — before anything is known
	# about what those names will serve. A control with no present benefit and an
	# unbounded future commitment is the wrong default. The contract's
	# reservation of the directive to the Operations Owner is a governance rule
	# and is untouched by this correction.
	#
	# **No `preload`** either — that is a submission to a browser-vendor list and
	# is close to irreversible.
	#
	# **On a test hostname this is a real commitment**: every browser that visits
	# will refuse plain HTTP to this name for a year. That is acceptable because
	# nothing is ever served here over HTTP, and it is the same posture production
	# will carry.
	header Strict-Transport-Security "max-age=31536000"

	# ------------------------------------------------------------------
	# Who may reach it — remove at go-live, along with this whole file
	# ------------------------------------------------------------------
	# A password rather than an address allowlist, deliberately: the Operations
	# Owner has to reach this from a laptop and from a phone on mobile data for
	# the responsive checks, and an allowlist would make every network change an
	# operator task. Certificate Transparency publishes the hostname within
	# minutes of issuance, so an unreviewed portal cannot be left open.
	#
	# **This gate must be gone before the final security-header evidence run**:
	# a 401 in front of the application is not the response the accepted contract
	# describes, and TC-SEC-07 must observe the application's own answers.
	# **No credential material in this repository (C35-01).** The verifier lives in
	# a host-local fragment owned by root and readable by Caddy, generated by
	# `infra/staging/rotate-test-gate.sh`, which prints its password once to the
	# operator's terminal and writes it nowhere.
	#
	# The import **fails closed**: if the fragment is absent, Caddy refuses the whole
	# configuration rather than serving this site unprotected. `caddy validate` will
	# say so before any reload, which is the intended failure and not a fault.
	import /etc/caddy/freedom-blades-test.gate

	# ------------------------------------------------------------------
	# Health is loopback-only and is never published (C35-02)
	# ------------------------------------------------------------------
	# The accepted operational contract puts `/healthz` on the loopback bind and
	# states it is not published by Caddy: it names check results, and an
	# unauthenticated reader of them learns the deployment's internal state. It
	# stays up during a kill switch precisely so an operator can watch it *on the
	# host*, which is where TC-PERF-03 and monitoring must read it.
	#
	# This is the **first** handle block, so the refusal precedes the catch-all
	# proxy and no form of the path can fall through to it. `404` rather than `403`:
	# a refusal that distinguishes "exists but forbidden" from "not here" is itself
	# a disclosure.
	@health path /healthz /healthz/ /healthz/*
	handle @health {
		respond 404
	}

	# ------------------------------------------------------------------
	# The passkey registration page — temporary ceremony scaffolding
	# ------------------------------------------------------------------
	# Served by Caddy as a static file, never by the portal: enrollment stays
	# host-local and there is still no HTTP route that enrols a credential
	# (route contract §8, TC-BG-10). It lives on this origin only because a
	# passkey is bound to the address of the page that creates it, so the
	# ceremony has to happen here to produce a credential that works here.
	#
	# Delete this handler the moment both passkeys are enrolled.
	handle /enrol* {
		root * /opt/freedom-blades/platform/infra/ceremony
		rewrite * /passkey-registration.html
		file_server
	}

	# ------------------------------------------------------------------
	# Everything else is the portal
	# ------------------------------------------------------------------
	handle {
		# N-34 trusts exactly one hop and reads the right-most X-Forwarded-For
		# entry. Cloudflare terminates TLS in front, so without this rewrite the
		# right-most entry is Cloudflare's address and the N-30/N-31
		# authentication limiter would count every visitor as one source.
		reverse_proxy 127.0.0.1:8001 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
			transport http {
				read_timeout 35s
				write_timeout 35s
			}
		}
	}

	# N-55/N-19: 1 MiB, matching WEB_MAX_REQUEST_BYTES exactly. TC-LIM-02's
	# parity assertion reads this number.
	request_body {
		max_size 1MiB
	}

	# No security headers here, deliberately. The application owns CSP (N-26),
	# Referrer-Policy, X-Content-Type-Options, COOP and CORP, and P3.4's tests
	# assert the exact set on real responses. Two CSP headers are both enforced
	# by browsers, so a proxy-added policy would silently break certified pages,
	# and the application omits X-Frame-Options on purpose in favour of
	# frame-ancestors 'none' (F-12).
}
