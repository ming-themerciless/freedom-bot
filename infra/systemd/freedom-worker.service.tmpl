# `freedom-worker` — the process that executes durable reconciliation jobs (N-40).
#
# Copy to /etc/systemd/system/freedom-worker.service and replace the __PLACEHOLDER__
# values. Never commit a filled-in copy: EnvironmentFile points at the secrets.
#
# ## Why this is a separate unit and not a thread in freedom-web
#
# Operational contract §3. The work holds the GIL for ~9.6 seconds, its peak
# memory is per-job — measured at 302 MiB for a real 32-Actor folder on
# 2026-08-27 (TC-PERF-01), and unmeasured anywhere near N-20's 64 MiB input
# ceiling — and a web deploy should be quick while a worker holding a 60-second
# lease should drain. All three are unit-level properties, which is why they are
# expressed here.
#
# ## The three numbers below are the accepted ones, and each has a reason
#
# `MemoryMax=2G`   — N-47, **raised from 1G on 2026-08-27** (C-P3.5-Z), after
#                    TC-PERF-01 finally measured what this bounds. A real
#                    32-Actor folder peaked at **302 MiB**; the same corpus
#                    synthetic peaked at 185 MiB, and real Actor data costs
#                    ~13-15x its input size where the fixture cost ~7.5x
#                    (N-26). Extrapolated to N-20's 64 MiB ceiling that reaches
#                    ~1 GiB — at the old bound. 2G on a 7.7 GB host is a quarter
#                    of it and ~2x the worst realistic case.
#
#                    **This is a runaway guard, not a budget.** It exists to
#                    break a loop, not to restrain normal work, and raising it
#                    protects the job slightly more and the shared host slightly
#                    less. A job killed by the ceiling is
#                    an abandoned attempt, not a failure verdict: the lease
#                    expires, the reaper requeues it while an attempt remains,
#                    and the durable effect is fenced by the import's own unique
#                    constraints either way.
# `TimeoutStopSec=30` — N-52. **Deliberately below the 60-second lease** (N-23).
#                    A shutdown that outlived the lease would let a restarting
#                    process hold a claim it can no longer heartbeat.
# `Restart=on-failure` — a crashed worker's claim is recovered by the reaper
#                    within N-23 + N-44, so restarting is safe and losing the
#                    process is not a data-integrity event.

[Unit]
Description=Freedom Blades portal reconciliation worker
Wants=network-online.target postgresql.service
After=network-online.target postgresql.service
# The worker does not serve the portal and the portal does not need the worker to
# answer: a queued job waits, which is the whole point of a durable queue. So
# there is no ordering dependency on freedom-web in either direction.

[Service]
Type=simple
WorkingDirectory=__REPOSITORY_ROOT__
# The same virtualenv and the same code as freedom-web. The processes differ by
# WORKER_ENABLED and by nothing else, and each refuses the other's value.
ExecStart=__WEB_VENV__/bin/python -m tools.freedom_worker
# ## Why `WORKER_ENABLED=true` is a **file** here and not an `Environment=` line
#
# This is the defect that kept this unit from ever starting once (2026-08-25, F5),
# and it is a systemd precedence rule rather than anything about this application.
# `systemd.exec(5)`, on `EnvironmentFile=`:
#
#     Settings from these files override settings made with Environment=.
#
# The shared portal environment file sets `WORKER_ENABLED=false`, because it is
# also `freedom-web`'s file and S-11 refuses a web process that claims jobs. So an
# `Environment=WORKER_ENABLED=true` line on this unit is read **first** and then
# overwritten by the file, and the worker refuses itself with S-11 on every start —
# silently, in the sense that the unit looks correctly configured to anyone reading
# it.
#
# The mechanism that does work is a second file, listed **after** the shared one:
#
#     If the same variable is set twice from these files, the files will be read in
#     the order they are specified and the later setting will override the earlier
#     setting.
#
# `__WORKER_ENVIRONMENT_FILE__` therefore holds exactly one line —
# `WORKER_ENABLED=true` — and nothing secret. Its whole job is to state the one
# variable that distinguishes this process from `freedom-web`, in the only place
# systemd will let it win. **Order matters: it must come second.**
EnvironmentFile=__ENVIRONMENT_FILE__
EnvironmentFile=__WORKER_ENVIRONMENT_FILE__
Environment=PYTHONUNBUFFERED=1
User=__SERVICE_USER__
Group=__SERVICE_GROUP__

Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

# N-47. Measured 2026-08-27: real peak 302 MiB (TC-PERF-01). See N-26.
MemoryMax=2G

# The worker exposes no listener at all (N-50), so it needs no network
# capability beyond the loopback PostgreSQL socket its pool opens.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
# The restricted artifact store is the one path outside the repository the
# worker writes to — and it only ever reads there. Named explicitly so
# ProtectSystem=strict does not have to be relaxed wholesale.
ReadWritePaths=__ARTIFACT_ROOT__
ReadOnlyPaths=__REPOSITORY_ROOT__

[Install]
WantedBy=multi-user.target
