[Unit]
Description=Lavalink audio node (v4)
After=network.target

[Service]
User=lavalink
Group=lavalink
WorkingDirectory=/opt/lavalink
ExecStart=/usr/bin/java -Xms256m -Xmx1g -jar /opt/lavalink/Lavalink.jar
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
