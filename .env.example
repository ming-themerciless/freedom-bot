# ==== Discord ====
DISCORD_TOKEN=__PUT_YOUR_DISCORD_BOT_TOKEN_HERE__
GUILD_ID=__GUILD_ID__
ROLL_CHANNEL_ID=__CHANNEL_ID_FOR_ROLLS__
TRADE_CHANNEL_ID=__CHANNEL_ID_FOR_TRADES__
DT_CHANNEL_ID=__CHANNEL_ID_FOR_DOWNTIME__
BASTION_CHANNEL_ID=__CHANNEL_ID_FOR_BASTION__

# ==== Google Sheets ====
# ID der Google-Tabelle (die lange ID in der URL)
GUILD_SHEET_ID=__GOOGLE_SHEET_ID__

# Service-Account-Creds als EINZEILIGE JSON-Zeichenkette.
# Tipp: Doppelte Anführungszeichen bleiben, Newlines im private_key als \n.
# Beispiel-Form (PLATZHALTER!):
# SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\nABC...\n-----END PRIVATE KEY-----\n","client_email":"bot@proj.iam.gserviceaccount.com","client_id":"123","token_uri":"https://oauth2.googleapis.com/token"}'
SERVICE_ACCOUNT_JSON='__MINIFIED_SERVICE_ACCOUNT_JSON__'

# ==== Musik / Lavalink ====
# 1 = Musikbefehle aktiv, 0 = aus
ENABLE_MUSIC=1
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=__YOUR_LAVALINK_PASSWORD__
YTDLP_COOKIES_FILE=/opt/discord-bots/freedom-bot/yt-cookies.txt
