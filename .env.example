# ==== Discord ====
DISCORD_TOKEN=__PUT_YOUR_DISCORD_BOT_TOKEN_HERE__
GUILD_ID=__GUILD_ID__
ROLL_CHANNEL_ID=__CHANNEL_ID_FOR_ROLLS__
TRADE_CHANNEL_ID=__CHANNEL_ID_FOR_TRADES__
DT_CHANNEL_ID=__CHANNEL_ID_FOR_DOWNTIME__
BASTION_CHANNEL_ID=__CHANNEL_ID_FOR_BASTION__

# ==== Google Sheets ====
# ID der Google-Tabelle (die lange ID in der URL)
GUILD_SHEET_ID=__GOOGLE_SHEET_ID__

# Service-Account-Creds als EINZEILIGE JSON-Zeichenkette.
# Tipp: Doppelte Anführungszeichen bleiben, Newlines im private_key als \n.
# Beispiel-Form (PLATZHALTER!):
# SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\nABC...\n-----END PRIVATE KEY-----\n","client_email":"bot@proj.iam.gserviceaccount.com","client_id":"123","token_uri":"https://oauth2.googleapis.com/token"}'
SERVICE_ACCOUNT_JSON='__MINIFIED_SERVICE_ACCOUNT_JSON__'

# Optional, and read only by tools/import_sheet_characters.py and
# tools/identity_migration.py (C-04) -- never by the bot and never by the web
# portal. A SECOND service account holding only Viewer on the spreadsheet, used
# with the .../auth/spreadsheets.readonly scope, so that a migration run cannot
# write to the Sheet even by mistake. Leave unset and the reader falls back
# to SERVICE_ACCOUNT_JSON above and warns that it did -- react to that warning,
# because the shared account can write.
#
# Google Sheets is legacy MIGRATION INPUT with an end date, not a platform
# component: the Google client libraries are deliberately absent from
# requirements-web.txt, C-04 runs from a separate temporary operator environment,
# and this credential is retired after the approved verification window.
# See docs/operations/identity-evidence-migration.md and
# docs/operations/sheet-import.md.
# SHEET_READONLY_SERVICE_ACCOUNT_JSON='__MINIFIED_READONLY_SERVICE_ACCOUNT_JSON__'

# ==== PostgreSQL (Phase 1+) ====
# Not read by the Discord bot. Phase 1 wires these to migrations and tests only.
# Development and production must use distinct databases and restricted roles.
# The running application role must not own the schema or run migrations.
#
# Selects which database name is permitted: development|test|staging|production.
# Defaults to development, so an unqualified migration can only reach freedom_dev.
#
# Migrations and the destructive database tests require the local PostgreSQL
# Unix-domain socket: no host in the URL (as below), or ?host=/var/run/postgresql.
# A TCP URL is refused for them, loopback included, because 127.0.0.1:5432 can be
# an SSH local port forward to another host's PostgreSQL and the server at the
# far end reports loopback addresses just as a local one does.
#
# Keep PGHOSTADDR unset. libpq dials `hostaddr` and keeps `host` only for
# authentication, so PGHOSTADDR turns either socket spelling above into a TCP
# connection to that address -- and a remote one would receive these credentials.
# The combination is refused before anything connects. See
# docs/operations/database-development.md.
APP_ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://__APP_USER__:__PASSWORD__@/__DATABASE__
# Tests require a disposable PostgreSQL database containing synthetic data only.
# It must differ from DATABASE_URL: the integration tests drop every table.
TEST_DATABASE_URL=postgresql+psycopg://__TEST_USER__:__PASSWORD__@/__TEST_DATABASE__

# ==== Foundry snapshot submission (Phase 2 I-03) ====
# Read only by the snapshot submission endpoint -- never by the Discord bot.
# See docs/operations/foundry-snapshot-submission.md.
#
# Absolute directory, OUTSIDE this repository, holding the immutable snapshot
# artifacts. There is deliberately no default: every default would be a guess
# about which filesystem holds every exported Actor's mechanics. It is created
# 0700 and each artifact 0600, named for its own SHA-256 and never for anything
# a caller supplied. No application route serves an artifact and there is no
# directory listing; retention and deletion are operator actions.
#
# The state is ENFORCED, at startup and on every store and read, and never
# repaired: it must be a real path with no symlinked component, a directory
# owned by the service account, granting nothing to group or other, on a
# filesystem that can fsync a directory. The service refuses to start otherwise,
# naming a fixed reason and never the path. See §5.6 of the operations document.
#
# THE FILESYSTEM MUST SUPPORT HARD LINKS. Publication creates the artifact's
# directory entry with link(2), which fails rather than overwriting an entry the
# service has not validated -- that is what stops a concurrent or unexpected file
# under a checksum name being silently destroyed. ext4, XFS, Btrfs, ZFS and tmpfs
# are fine; FAT/exFAT and some network mounts are not. Startup proves it and
# refuses `link_unsupported` if it does not hold.
#
# One consequence for whoever sizes this filesystem: publication writes a
# `.incoming-*` temporary, links the checksum name to it, and then unlinks the
# temporary BEST EFFORT. The service swallows a failure there rather than
# failing a submission whose artifact is already published, so it does not
# report one -- and a leftover `.incoming-*` link can survive a SUCCESSFUL store
# as well as a failed one. It is private (0600, in a 0700 root), no route serves
# it, and it can never invalidate or delete the published artifact; it consumes
# storage until an operator removes it. Operations §5.6, "Temporary files left
# by a failed cleanup", is the read-only procedure for finding them. Repeated
# leftovers mean the unlink is failing -- usually a drifted root mode or owner,
# or a full or read-only filesystem.
#
# The DIRECTORIES ABOVE IT are checked too, at startup: each must be owned by
# root or by the service account and must not be writable by others unless it
# carries the sticky bit. That is what stops another account renaming the store
# out from under the service. Check yours with `namei -l <path>` before
# deploying; the usual root:root 0755 chain satisfies it.
#
# The root is opened once and every later operation is resolved against that
# descriptor, so replacing the path while the service runs redirects nothing --
# but it is also refused (root_replaced) rather than ignored. MOVING OR
# REPLACING THE ARTIFACT ROOT THEREFORE REQUIRES A SERVICE RESTART.
FREEDOM_SNAPSHOT_ARTIFACT_ROOT=/srv/freedom/snapshots

# The credentials the endpoint accepts. One entry per principal, ';'-separated:
#
#     <id>|<scope>[,<scope>]|<sha256 of the secret, hex>
#
# This holds the DIGEST of the secret, never the secret -- so compromise of this
# file yields no usable credential. Generate a secret and its digest with the
# commands in docs/operations/foundry-snapshot-submission.md §5.2, give the
# secret to the submitting GM for their password manager, and put only the
# digest here.
#
# The secret is NOT stored in Foundry. A world setting's value is delivered to
# every client that joins the world, so the submitting GM enters it in the
# dialog once per submission. Operations document §4.1 records the Foundry
# source that establishes this.
#
# The only scope that exists is foundry:snapshot:submit. It permits uploading a
# snapshot and nothing else: not applying an import, not reading Council data,
# not mutating a character, not reaching PostgreSQL.
#
# Leaving this unset or empty is a valid configuration -- every request then
# fails authentication, which is also how "revoke everything" is spelled.
# FREEDOM_SNAPSHOT_PRINCIPALS='foundry-the-guild|foundry:snapshot:submit|__SHA256_HEX_OF_THE_SECRET__'

# The browser origins permitted to submit a snapshot. Comma- or
# whitespace-separated, EXACT origins only -- the scheme and host a browser
# actually sends, lower-case, with the port only when it is not the scheme's
# default. No wildcard, no suffix match, and no reflection of whatever arrived.
#
# The Foundry module submits from a browser with four non-safelisted headers, so
# the browser sends an unauthenticated OPTIONS preflight first and will not send
# the POST unless it is answered. This is the allowlist that answers it.
#
# Leaving this unset or empty is a valid configuration and the default: NO
# browser origin may submit. A caller that sends no Origin -- curl, the
# documented smoke test, the loopback rehearsal -- is unaffected either way.
# Malformed entries are refused at startup. See §5.4 of the operations document.
# FREEDOM_SNAPSHOT_ALLOWED_ORIGINS='https://foundry1.example.org,https://foundry2.example.org'


# ==== Freedom Blades web portal (Phase 3 P3.1) ====
# Read ONLY by the `freedom-web` process. The Discord bot reads no WEB_* or
# WORKER_* variable, exactly as it reads no FREEDOM_SNAPSHOT_* variable: the two
# processes have separate virtualenvs, separate systemd units and separate
# environment files, and `application/web/config.py` never imports the bot's
# `config.py` (startup refusal S-13).
#
# Every value below is a PLACEHOLDER. Configuration is validated once at startup
# by `WebSettings.from_environment`, which raises a typed error listing every
# problem it found and naming variables, never values. The fifteen refusals are
# S-01 to S-15 in docs/contracts/phase-3-configuration-and-dependency-contract.md.
#
# Where a variable carries a policy bound, configuration may make the platform
# STRICTER than the accepted policy and never looser. `WEB_SESSION_IDLE_MINUTES=30`
# is accepted; `=90` is refused. A configuration file cannot quietly raise an
# accepted security limit.

# -- environment and process ------------------------------------------------
# development | test | staging | production. Required. Every other environment
# check compares against it, and a production process started with a development
# database URL is the failure this variable exists to prevent.
WEB_ENVIRONMENT=development
# Must be loopback outside development: the public perimeter is Caddy, and the
# application port stays private.
WEB_BIND_HOST=127.0.0.1
WEB_BIND_PORT=8000
# In production this must be exactly https://freedom-blades.rpgworld.org. A
# non-production process that claims it is refused (S-02), because it would
# receive production cookies and OAuth callbacks.
WEB_PUBLIC_ORIGIN=http://127.0.0.1:8000
# Exact hostnames, comma-separated. A `*` anywhere is a startup refusal, and the
# public origin's own host must be present or the portal would refuse itself.
WEB_ALLOWED_HOSTS=127.0.0.1
# Layer 1 of the operator kill switch. While this file exists every route except
# /healthz answers 503, within one second, and the Discord bot and Foundry keep
# running. Engage and release it with `python -m tools.portal_kill_switch`.
WEB_KILL_SWITCH_FILE=/srv/freedom/web/kill-switch

# -- the four secret keys ---------------------------------------------------
# At least 32 bytes each, and all four DIFFERENT from one another. Key
# separation is what stops a CSRF token being a valid pagination cursor, or
# either being usable as encryption key material (S-08).
# Generate with: openssl rand -base64 32
WEB_SECRET_KEY_CSRF=__REPLACE_WITH_32_RANDOM_BYTES_BASE64__
WEB_SECRET_KEY_CURSOR=__REPLACE_WITH_A_DIFFERENT_32_RANDOM_BYTES_BASE64__
# Salts the digests of client addresses and user-agent strings. An unkeyed
# SHA-256 of an IPv4 address is reversible by exhaustive search in seconds, so
# without this the "hashed" address would be the address with extra steps.
WEB_SECRET_KEY_CLIENT_DIGEST=__REPLACE_WITH_A_THIRD_32_RANDOM_BYTES_BASE64__

# -- database ---------------------------------------------------------------
# Validated by the EXISTING adapters/database validator, with the runtime
# policy: the web process creates and drops nothing. The database name must
# match WEB_ENVIRONMENT (S-01).
WEB_DATABASE_URL=postgresql+psycopg:///freedom_dev
WEB_DATABASE_POOL_SIZE=5
WEB_DATABASE_MAX_OVERFLOW=5
WEB_DATABASE_TIMEOUT_SECONDS=5
# A web request that needs more than ten seconds of SQL is a defect; this is
# what stops it holding a connection while it proves that.
WEB_DATABASE_STATEMENT_TIMEOUT_MS=10000

# -- identity providers -----------------------------------------------------
# Phase 3 accepts exactly one provider key: `discord`. Adding another requires
# its own accepted provider, privacy, account-linking and migration package
# (ADR 0010 D7); a typo here would otherwise create a shadow subject namespace.
WEB_PROVIDER_REGISTRY=discord
WEB_DISCORD_CLIENT_ID=__REPLACE_WITH_THE_DISCORD_APPLICATION_CLIENT_ID__
WEB_DISCORD_CLIENT_SECRET=__REPLACE_WITH_THE_DISCORD_APPLICATION_CLIENT_SECRET__
# Must share WEB_PUBLIC_ORIGIN: a callback delivered to another origin is a
# token-leak path (S-05). In production it must be exactly
# https://freedom-blades.rpgworld.org/auth/discord/callback, because that is
# what is registered at the provider.
WEB_DISCORD_REDIRECT_URI=http://127.0.0.1:8000/auth/discord/callback
# Exactly these two. A wider scope is a startup refusal, not a warning: scope
# creep is a privacy change, not a configuration convenience (S-06).
WEB_DISCORD_SCOPES=identify,guilds.members.read
# The production guild is 1052698198180892733. A non-production process
# configured with it is refused, and a production process without it is refused
# (S-07): no implementation package may use the production Discord application
# or guild for automated tests.
WEB_DISCORD_GUILD_ID=__REPLACE_WITH_THE_STAGING_GUILD_SNOWFLAKE__
WEB_DISCORD_API_TIMEOUT_SECONDS=5
# The protected Server Administrator role. Read ONLY by migration 0006, which
# inserts the protected role-capability mapping and refuses to run without it.
# Council and DM role snowflakes are deliberately NOT configuration: OD-18 puts
# capability mappings in the database, managed by the administrator workflow.
WEB_BOOTSTRAP_ADMIN_ROLE_ID=__REPLACE_WITH_THE_ADMINISTRATOR_ROLE_SNOWFLAKE__

# -- sessions and cookies ---------------------------------------------------
# `__Host-fb_session` when cookies are secure; a distinct development name
# otherwise, because browsers refuse the `__Host-` prefix without Secure.
# WEB_SESSION_COOKIE_NAME=__Host-fb_session
# Must be true outside development. A session cookie without Secure is a session
# cookie an attacker can strip TLS to read (S-03).
WEB_COOKIE_SECURE=false
WEB_SESSION_IDLE_MINUTES=60
WEB_SESSION_ABSOLUTE_HOURS=12
# Break-glass sessions are short because they are an emergency, not a way of
# working, and there is no extension beyond the absolute bound.
WEB_EMERGENCY_SESSION_IDLE_MINUTES=15
WEB_EMERGENCY_SESSION_ABSOLUTE_MINUTES=60
WEB_MAX_SESSIONS_PER_ACCOUNT=10
WEB_OAUTH_TRANSACTION_MINUTES=10

# -- WebAuthn and recovery --------------------------------------------------
# Must equal the public origin's own host. A broader relying-party identifier
# would also cover the sibling Foundry hostnames under the same registrable
# domain, and a page served there could then use the platform's credentials
# (S-09).
WEB_WEBAUTHN_RP_ID=127.0.0.1
WEB_WEBAUTHN_RP_NAME=Freedom Blades
# WEB_WEBAUTHN_ALLOWED_ORIGINS=http://127.0.0.1:8000
# `required`. A break-glass credential that can be presented without user
# verification is a key somebody found rather than a key somebody holds.
WEB_WEBAUTHN_USER_VERIFICATION=required
WEB_RECOVERY_GRANT_MINUTES=10

# -- encryption -------------------------------------------------------------
# Versioned AES-256-GCM key material, newest first, as `version:base64key`.
# Each key is exactly 32 bytes. Rotation is: add a key, switch the active
# version, re-encrypt in the background, remove the old key -- with no moment at
# which a stored token cannot be read.
WEB_TOKEN_ENCRYPTION_KEYS=1:__REPLACE_WITH_32_RANDOM_BYTES_BASE64__
WEB_TOKEN_ENCRYPTION_ACTIVE_VERSION=1

# -- bounds -----------------------------------------------------------------
WEB_MEMBERSHIP_CACHE_SECONDS=300
# After this much time without a successful membership observation, protected
# reads stop and the portal fails closed. Mutations fail immediately, without
# consuming the grace at all.
WEB_MEMBERSHIP_GRACE_SECONDS=900
WEB_RATE_LIMIT_WINDOW_MINUTES=10
WEB_RATE_LIMIT_OAUTH_STARTS=10
WEB_RATE_LIMIT_OAUTH_CALLBACKS=20
WEB_RATE_LIMIT_WEBAUTHN_PER_IP=5
WEB_RATE_LIMIT_WEBAUTHN_PER_ACCOUNT=10
WEB_RATE_LIMIT_WEBAUTHN_ACCOUNT_WINDOW_MINUTES=60
WEB_RATE_LIMIT_RECOVERY_PER_IP=3
WEB_RATE_LIMIT_RECOVERY_PER_GRANT=5
WEB_RATE_LIMIT_CLEANUP_MINUTES=60
WEB_MAX_REQUEST_BYTES=1048576
# Exactly one proxy hop, trusted only when the transport peer is loopback. The
# right-most X-Forwarded-For entry is the one the trusted proxy appended;
# everything to its left was supplied by whoever was talking to the proxy.
WEB_TRUSTED_PROXY_HOPS=1
WEB_AUDIT_PAGE_SIZE_DEFAULT=50
WEB_AUDIT_PAGE_SIZE_MAX=100
WEB_POLL_MIN_SECONDS=2

# -- worker (P3.3 implements it; P3.1 only refuses the wrong combination) ----
# The web process must set this false and the worker process true. A web process
# that claimed jobs would execute the GIL-holding preview work inside the
# request loop, stalling polling, health and every other request (S-11).
WORKER_ENABLED=false
WORKER_CONCURRENCY=1
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=20
WORKER_MAX_ATTEMPTS=3
WORKER_ATTEMPT_TIMEOUT_SECONDS=300
WORKER_QUEUE_MAX_DEPTH=5
# The existing Phase 2 restricted artifact store, validated by the existing
# Phase 2 checks (ownership, mode, symlink-free, trusted ancestors) -- S-12.
# WORKER_ARTIFACT_ROOT=/srv/freedom/snapshots
