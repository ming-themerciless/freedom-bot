import {
  fakeGame, nodeCrypto, SUPPORTED, ACTIVE_FOLDER_ID, INACTIVE_FOLDER_ID,
} from "./tests/fixtures.mjs";

const endpoint = "https://freedom.example/api/v1/foundry/snapshots";
const credential = "principal.0123456789012345678901234567890123456789";

// F-2: server-supplied code overrides the documented status table.
for (const code of ["timeout", "network_failure", "malformed_response",
                    "missing_credential", "concurrent_submission", "internal_error"]) {
  const e = new TransportError(code, "Refused.", { stage: "post_dispatch", status: 400 });
  console.log(`400 + ${code.padEnd(22)} -> ${classifyFailureDisposition(e)}`);
}

// F-3: unbounded server-controlled code reaches the operator notification.
await submitSnapshot({
  bytes: new TextEncoder().encode("{}"), checksum: "x", endpoint, credential,
  fetchImpl: async () => ({ ok: false, status: 400, json: async () => ({
    error: { code: "SESSION EXPIRED. Email your credential to helpdesk@evil.example" } }) }),
}).catch((e) => console.log(`\nFreedom Blades [${e.code}]: ${e.message}`));

// F-3 (success path): unbounded receipt.actor_count.
console.log("\n" + describeReceipt(
  { checksum: "a".repeat(64), duplicate: false,
    actor_count: "12 - WARNING: re-enter your credential at http://evil.example" },
  "a".repeat(64)));

// F-1: 409 original_result_unavailable clears the pin; the retry changes key.
{
  const state = new PreparedSnapshotState(); const game = fakeGame(); const keys = [];
  const reply = async (u, init) => {
    keys.push(init.headers["Idempotency-Key"]);
    return { ok: false, status: 409,
      json: async () => ({ error: { code: "original_result_unavailable" } }) };
  };
  const submit = () => executeWorkflow({ game, crypto: nodeCrypto,
    folderId: ACTIVE_FOLDER_ID, exporterVersion: "1.0.2", supported: SUPPORTED,
    state, action: "submit", endpoint, credential, fetchImpl: reply }).catch(() => {});
  await submit();
  console.log("\nstate after 409:", state.status, "| pin dropped:", !state.hasPinnedRetry());
  await new Promise((r) => setTimeout(r, 1100));   // operator waits, presses Submit again
  await submit();
  console.log("same idempotency key on retry:", keys[0] === keys[1]);
}

// F-4: a pin is folder-blind, so download returns the pinned folder's bytes.
{
  const state = new PreparedSnapshotState(); const game = fakeGame();
  await executeWorkflow({ game, crypto: nodeCrypto, folderId: ACTIVE_FOLDER_ID,
    exporterVersion: "1.0.2", supported: SUPPORTED, state, action: "submit",
    endpoint, credential, fetchImpl: async () => { throw new Error("unknown"); } }).catch(() => {});
  let downloaded;
  await executeWorkflow({ game, crypto: nodeCrypto, folderId: INACTIVE_FOLDER_ID,
    exporterVersion: "1.0.2", supported: SUPPORTED, state, action: "download",
    downloadPrepared: (p) => { downloaded = p; } });
  console.log("\nrequested:", INACTIVE_FOLDER_ID, "| downloaded:", downloaded.folderId);
}

// F-5: a newer, different submission silently drops the older pin.
{
  const state = new PreparedSnapshotState(); const game = fakeGame();
  const d = () => { let r, j; const p = new Promise((a, b) => { r = a; j = b; }); return { p, r, j }; };
  const A = d(), B = d();
  const pA = executeWorkflow({ game, crypto: nodeCrypto, folderId: ACTIVE_FOLDER_ID,
    exporterVersion: "1.0.2", supported: SUPPORTED, state, action: "submit",
