    exporterVersion: "1.0.2", supported: SUPPORTED, state, action: "submit",
    endpoint, credential, fetchImpl: async () => B.p });
  B.r({ ok: true, status: 201, json: async () => ({ checksum: "b", actor_count: 1 }) });
  await pB; A.j(new Error("connection reset")); await pA.catch(() => {});
  console.log("\nolder delivery indeterminate; pin held:", state.hasPinnedRetry());
