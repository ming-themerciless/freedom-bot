# venv & Python
venv/
# The portal's separate virtualenv (topology §1). Its resolved contents are
# committed as `requirements-web.lock`; the tree itself is not.
venv-web
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Env/Secrets
.env
*.env
.env.*
service_account.json
*.pem
*.key

# Foundry Actor exports — real character documents supplied for structural
# verification only. They are read outside the repository and never committed;
# see docs/discovery/fixture-strategy.md (fixtures are synthetic by construction).
fvtt-Actor-*.json

# Supervised rehearsal screenshots — maintainer-supplied browser evidence that
# may show world, folder or Actor content. Retained outside version control and
# referenced from the rehearsal record by description only.
docs/screenshots/

# Logs & tmp
logs/
*.log
.DS_Store

# Node/lavalink cache (falls vorhanden)
node_modules/

yt-cookies.txt
